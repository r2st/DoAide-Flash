[Unit]
Description=DoAide Flash - Free Flashcard Study Tool
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/DoAide-Flash
ExecStart=/usr/bin/node node_modules/.bin/vite preview --host 172.18.0.1 --port 3063
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
